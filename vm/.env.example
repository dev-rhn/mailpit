# Domain untuk Web UI (A record -> IP VM)
MAILPIT_UI_DOMAIN=mailpit.domainkamu.com

# Login Web UI, format user:password (ganti password!)
MP_UI_AUTH='admin:GantiPasswordKuat'

# Regex alamat penerima yang diterima (domain dummy dengan MX -> VM ini)
MP_SMTP_ALLOWED_RECIPIENTS='@mail\.domainkamu\.com$'

MP_MAX_MESSAGES=5000
MP_MAX_AGE=30d
TZ=Asia/Jakarta
